{
  "name": "nikon-uvc-ptp-bridge",
  "version": "0.1.0",
  "description": "Windows-first bridge: exclusive Nikon USB access, virtual camera output, and PTP-style control surface",
  "type": "module",
  "main": "out/main/index.js",
  "author": "AMDphreak",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win zip --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "~5.7.2",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "com.amdphreak.nikonUvcPtpBridge",
    "productName": "Nikon UVC-PTP Bridge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "forceCodeSigning": false
  }
}
